APP_NAME=ReBox
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5001

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rebox
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Leave empty to fall back to GOOGLE_EMAIL / GOOGLE_APP_PASSWORD
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

PORT=5001
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
PUBLIC_BASE_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
# LAN sharing: keep these as localhost. Run `composer run serve:lan` + frontend `npm run dev:lan`.
# API/image URLs rewrite to the LAN IP automatically from the request host.

ADMIN_EMAIL=admin@rebox.com
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="ReBox Admin"

PLATFORM_FEE_PERCENT=10
BUYER_CONFIRM_HOURS=48
OFFER_TTL_HOURS=48

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

GOOGLE_EMAIL=
GOOGLE_APP_PASSWORD=

# Self-hosted rebox-ai (no third-party AI API keys)
REBOX_AI_URL=http://127.0.0.1:8100
REBOX_AI_TIMEOUT=180
# Absolute paths recommended
REBOX_AI_DATASET_DIR=
REBOX_AI_ROOT=
REBOX_AI_EXPORT_MIN_APPROVED=20
REBOX_AI_EXPORT_VAL_RATIO=0.2
# Auto-retrain gates (used by ai:run-retrain-pipeline)
REBOX_AI_AUTO_MIN_TRAIN=10
REBOX_AI_AUTO_MIN_CATEGORY=0.40
REBOX_AI_AUTO_MIN_CONDITION=0.30
REBOX_AI_AUTO_EVAL_LIMIT=10

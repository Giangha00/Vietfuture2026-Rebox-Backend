<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="card-title mb-0">Orders</h3>
    <form method="get" class="form-inline">
      <select name="status" class="form-control form-control-sm mr-2" onchange="this.form.submit()">
        <option value="">All statuses</option>
        <% const statuses = ['pending_payment','paid','seller_confirmed','pickup_assigned','picked_up','out_for_delivery','delivered','completed','cancelled','disputed']; %>
        <% statuses.forEach(function(s) { %>
          <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
    </form>
  </div>
  <% if (success) { %><div class="alert alert-success m-3"><%= success %></div><% } %>
  <% if (error) { %><div class="alert alert-danger m-3"><%= error %></div><% } %>
  <div class="card-body table-responsive p-0">
    <table class="table table-hover text-nowrap">
      <thead>
        <tr>
          <th>ID</th>
          <th>Buyer</th>
          <th>Total</th>
          <th>Status</th>
          <th>Payment</th>
          <th>Escrow</th>
          <th>Shipper</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!orders.length) { %>
          <tr><td colspan="9" class="text-center text-muted p-4">No orders</td></tr>
        <% } %>
        <% orders.forEach(function(order) { %>
          <tr>
            <td><code><%= String(order._id).slice(-8) %></code></td>
            <td><%= order.buyer ? order.buyer.fullName : '—' %></td>
            <td><%= formatMoney(order.totalAmount) %></td>
            <td><span class="badge badge-info"><%= order.status %></span></td>
            <td><%= order.paymentStatus || '—' %></td>
            <td><%= order.escrowStatus || '—' %></td>
            <td><%= order.shipper ? order.shipper.fullName : '—' %></td>
            <td><%= order.createdAt ? new Date(order.createdAt).toLocaleString() : '—' %></td>
            <td><a class="btn btn-xs btn-primary" href="/admin/orders/<%= order._id %>">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

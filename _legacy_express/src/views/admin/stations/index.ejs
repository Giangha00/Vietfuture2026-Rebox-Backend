<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<div class="card">
  <div class="card-header">
    <a href="/admin/stations/new" class="btn btn-primary">Create station</a>
  </div>
  <div class="card-body table-responsive p-0">
    <table class="table table-hover text-nowrap">
      <thead>
        <tr>
          <th>Partner</th>
          <th>City</th>
          <th>Address</th>
          <th>Locker</th>
          <th>Active</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% stations.forEach(function(station) { %>
          <tr>
            <td><%= station.partnerName %></td>
            <td><%= station.city %></td>
            <td><%= station.address %></td>
            <td><%= station.lockerCode %></td>
            <td><%= station.isActive ? 'Yes' : 'No' %></td>
            <td class="text-right">
              <a class="btn btn-sm btn-outline-primary" href="/admin/stations/<%= station._id %>/edit">Edit</a>
              <form action="/admin/stations/<%= station._id %>/delete" method="post" class="d-inline" onsubmit="return confirm('Delete this station?')">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

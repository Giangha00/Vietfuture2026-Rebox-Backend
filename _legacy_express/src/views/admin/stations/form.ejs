<div class="card card-primary">
  <div class="card-header">
    <h3 class="card-title"><%= station && station._id ? 'Edit station' : 'Create station' %></h3>
  </div>
  <% if (error) { %><div class="alert alert-danger m-3"><%= error %></div><% } %>
  <form method="post" action="<%= station && station._id ? '/admin/stations/' + station._id : '/admin/stations' %>">
    <div class="card-body">
      <div class="form-group">
        <label>Partner</label>
        <select name="partnerName" class="form-control">
          <% ['Circle K','GS25','Other'].forEach(function(p) { %>
            <option value="<%= p %>" <%= station && station.partnerName === p ? 'selected' : '' %>><%= p %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>City</label>
        <input type="text" name="city" class="form-control" required minlength="2" value="<%= station ? (station.city || '') : '' %>">
      </div>
      <div class="form-group">
        <label>Address</label>
        <input type="text" name="address" class="form-control" required minlength="5" value="<%= station ? (station.address || '') : '' %>">
      </div>
      <div class="form-group">
        <label>Locker code</label>
        <input type="text" name="lockerCode" class="form-control" required minlength="1" value="<%= station ? (station.lockerCode || '') : '' %>">
      </div>
      <div class="form-check">
        <input type="checkbox" class="form-check-input" id="isActive" name="isActive" <%= !station || station.isActive ? 'checked' : '' %>>
        <label class="form-check-label" for="isActive">Active</label>
      </div>
    </div>
    <div class="card-footer">
      <button type="submit" class="btn btn-primary">Save</button>
      <a href="/admin/stations" class="btn btn-default">Cancel</a>
    </div>
  </form>
</div>

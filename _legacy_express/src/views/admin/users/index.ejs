<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<div class="card">
  <div class="card-header">
    <form class="form-inline" method="get" action="/admin/users">
      <input type="text" name="q" value="<%= q || '' %>" class="form-control mr-2" placeholder="Search users...">
      <button class="btn btn-default mr-2">Search</button>
      <a href="/admin/users/new" class="btn btn-primary">Create user</a>
    </form>
  </div>
  <div class="card-body table-responsive p-0">
    <table class="table table-hover text-nowrap">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Role</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function(user) { %>
          <tr>
            <td><%= user.fullName %></td>
            <td><%= user.email %></td>
            <td><%= user.phone || '—' %></td>
            <td><span class="badge badge-<%= user.role === 'admin' ? 'danger' : 'secondary' %>"><%= user.role %></span></td>
            <td><%= user.createdAt ? user.createdAt.toISOString().slice(0,10) : '—' %></td>
            <td class="text-right">
              <a class="btn btn-sm btn-outline-primary" href="/admin/users/<%= user._id %>/edit">Edit</a>
              <form action="/admin/users/<%= user._id %>/delete" method="post" class="d-inline" onsubmit="return confirm('Delete this user?')">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

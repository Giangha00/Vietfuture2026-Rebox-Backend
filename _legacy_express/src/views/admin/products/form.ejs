<div class="card card-primary">
  <div class="card-header">
    <h3 class="card-title"><%= product && product._id ? 'Edit product' : 'Create product' %></h3>
  </div>
  <% if (error) { %><div class="alert alert-danger m-3"><%= error %></div><% } %>
  <form method="post" action="<%= product && product._id ? '/admin/products/' + product._id : '/admin/products' %>">
    <div class="card-body">
      <div class="form-group">
        <label>Title</label>
        <input type="text" name="title" class="form-control" required minlength="3" maxlength="200" value="<%= product ? (product.title || '') : '' %>">
      </div>
      <div class="form-group">
        <label>Description</label>
        <textarea name="description" class="form-control" rows="4" required minlength="10" maxlength="5000"><%= product ? (product.description || '') : '' %></textarea>
      </div>
      <div class="row">
        <div class="col-md-4">
          <div class="form-group">
            <label>Price (USD)</label>
            <input
              type="text"
              inputmode="decimal"
              maxlength="13"
              name="price"
              class="form-control"
              required
              value="<%= product ? (product.price || '') : '' %>"
              placeholder="e.g. 25.99"
              oninput="(function(el){var v=el.value.replace(/[^\d.]/g,'').replace(/(\..*)\./g,'$1');var p=v.split('.');var i=p[0]||'';var d=(p[1]||'').slice(0,2);if(i.length>11){i=i.slice(0,11);d='';}else if(i.length+d.length>11){d=d.slice(0,11-i.length);}el.value=v.indexOf('.')>=0?i+'.'+d:i;})(this)"
            >
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-group">
            <label>Condition</label>
            <select name="condition" class="form-control">
              <% ['Like New','Good','Fair'].forEach(function(c) { %>
                <option value="<%= c %>" <%= product && product.condition === c ? 'selected' : '' %>><%= c %></option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-group">
            <label>Status</label>
            <select name="status" class="form-control">
              <% ['active','reserved','sold','archived'].forEach(function(s) { %>
                <option value="<%= s %>" <%= product && product.status === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-md-4">
          <div class="form-group">
            <label>Seller</label>
            <select name="seller" class="form-control" required>
              <% sellers.forEach(function(seller) { %>
                <option value="<%= seller._id %>" <%= product && String(product.seller) === String(seller._id) ? 'selected' : '' %>>
                  <%= seller.fullName %> (<%= seller.email %>)
                </option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-group">
            <label>Category</label>
            <select name="category" class="form-control" required>
              <% categories.forEach(function(category) { %>
                <option value="<%= category._id %>" <%= product && String(product.category) === String(category._id) ? 'selected' : '' %>>
                  <%= category.name %>
                </option>
              <% }) %>
            </select>
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-group">
            <label>Station</label>
            <select name="station" class="form-control" required>
              <% stations.forEach(function(station) { %>
                <option value="<%= station._id %>" <%= product && String(product.station) === String(station._id) ? 'selected' : '' %>>
                  <%= station.partnerName %> — <%= station.city %> — <%= station.lockerCode %>
                </option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>
      <div class="form-group">
        <label>Images (one URL per line)</label>
        <textarea name="images" class="form-control" rows="4"><%= product && product.images ? (Array.isArray(product.images) ? product.images.join('\\n') : product.images) : '' %></textarea>
      </div>
      <div class="form-group">
        <label>Moderation status</label>
        <select name="moderationStatus" class="form-control">
          <% ['pending','approved','rejected'].forEach(function(s) { %>
            <option value="<%= s %>" <%= product && product.moderationStatus === s ? 'selected' : (!product && s === 'approved' ? 'selected' : '') %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-check">
        <input type="checkbox" class="form-check-input" id="isVerified" name="isVerified" <%= product && product.isVerified ? 'checked' : '' %>>
        <label class="form-check-label" for="isVerified">Verified (Instant Checkout)</label>
      </div>
      <div class="form-check mt-2">
        <input type="checkbox" class="form-check-input" id="acceptsOffers" name="acceptsOffers" <%= !product || product.acceptsOffers !== false ? 'checked' : '' %>>
        <label class="form-check-label" for="acceptsOffers">Accept buyer offers (−5% / −10% / −15%)</label>
      </div>
    </div>
    <div class="card-footer">
      <button type="submit" class="btn btn-primary">Save</button>
      <a href="/admin/products" class="btn btn-default">Cancel</a>
    </div>
  </form>
</div>
